# Safe defaults
BINANCE_USE_TESTNET=true
BINANCE_LIVE_TRADING_ENABLED=false
BINANCE_TESTNET_TRADING_ENABLED=false
BINANCE_MAX_LEVERAGE=30
BINANCE_MAX_DAILY_TRADES=8
BINANCE_RECV_WINDOW_MS=5000
BINANCE_DEFAULT_SYMBOL=BTCUSDT
BINANCE_DEFAULT_MARKET=futures

# Binance mainnet credentials
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Optional separate testnet keys
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# Optional Blave alpha feed
blave_api_key=
blave_secret_key=

# Optional external market context. Missing keys degrade to neutral filters.
COINMARKETCAP_API_KEY=
ARKHAM_API_KEY=
CRYPTOPANIC_API_KEY=
GLASSNODE_API_KEY=
